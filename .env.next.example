# Work copy only. Never run this repo without these — the CLI falls back from the
# socket to the spool, so leaving either one at its default reaches the instance
# you are trying not to touch.
PILO_HOME=$HOME/pilo-next
PILO_PORT=48899
PILO_SOCKET=/tmp/pilo-next.sock
PILO_SPOOL=/tmp/pilo-next-spool
PILO_WATCHER=off
