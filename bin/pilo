#!/usr/bin/env bash
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
LAUNCH_CWD="$(pwd)"
while [[ -L "$SOURCE" ]]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"

# The node beside this install comes first: the one npm put it next to, or the
# private one the installer fetched into ~/.pilo/runtime. A Node manager
# switching versions, or no Node on PATH at all, then changes nothing here.
if [[ "$ROOT" == */lib/node_modules/* && -x "${ROOT%/lib/node_modules/*}/bin/node" ]]; then
  PATH="${ROOT%/lib/node_modules/*}/bin:$PATH"
fi

# pilo runs on macOS (the pilo app, open, launchd paths). The package no longer says
# so through npm's "os" field: that also stopped the site's Linux build from
# installing the repository at all.
if [[ "$(uname -s)" != "Darwin" && -z "${PILO_ANY_OS:-}" ]]; then
  echo "pilo runs on macOS only." >&2
  exit 1
fi

PILO_HOME_DIR="${PILO_HOME:-$HOME}/.pilo"
PORT_FILE="$PILO_HOME_DIR/port"
LOG_DIR="$PILO_HOME_DIR/logs"
LOG="$LOG_DIR/pilo.log"
PIDFILE="$PILO_HOME_DIR/server.pid"
WANTED_PORT="${PILO_PORT:-48888}"
mkdir -p "$LOG_DIR"
cd "$ROOT"

need() {
  command -v "$1" >/dev/null 2>&1 || { echo "Pilo requires $1."; exit 1; }
}

live_port() {
  if [[ -f "$PORT_FILE" ]]; then cat "$PORT_FILE"; else echo "$WANTED_PORT"; fi
}

health() {
  curl -fsS "http://127.0.0.1:$(live_port)/health" >/dev/null 2>&1
}

wait_http() {
  for _ in $(seq 1 40); do
    health && return 0
    sleep 0.25
  done
  return 1
}

# the Rust build named in ~/.pilo/engine runs everything below but the TUI and the update (#6239); ~/.pilo/bin/pilo
# follows it, the name Claude Code's and Codex's hooks call
ENGINE="$(cat "$PILO_HOME_DIR/engine" 2>/dev/null || true)"
if [[ -n "$ENGINE" && -x "$ENGINE" ]]; then
  mkdir -p "$PILO_HOME_DIR/bin"
  [[ "$(readlink "$PILO_HOME_DIR/bin/pilo" 2>/dev/null)" == "$ENGINE" ]] || ln -sfn "$ENGINE" "$PILO_HOME_DIR/bin/pilo"
else
  ENGINE=""
fi

ensure_server() {
  [[ -n "$ENGINE" ]] || need node
  need curl

  health && return

  # The database is a file directory the server opens itself; there is nothing to
  # start first. The server applies migrations, picks a free port and records it
  # in ~/.pilo/port.
  # ~/.pilo/engine names another server binary to run instead (the Rust one,
  # tools/db/cutover.sh); without it, or when it is gone, the Node server runs
  if [[ -n "$ENGINE" ]]; then
    PILO_PORT="$WANTED_PORT" nohup "$ENGINE" serve >> "$LOG" 2>&1 &
  else
    PILO_PORT="$WANTED_PORT" nohup node "$ROOT/src/server.js" >> "$LOG" 2>&1 &
  fi
  echo $! > "$PIDFILE"
  wait_http || { echo "Pilo server failed. See $LOG"; exit 1; }
}

# Stops the server this launcher started, and waits until it no longer answers
# so a start right after does not find the old one still up.
stop_server() {
  if [[ -f "$PIDFILE" ]] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
    kill "$(cat "$PIDFILE")"
    for _ in $(seq 1 40); do
      health || break
      sleep 0.25
    done
  fi
  rm -f "$PIDFILE"
}

# Which server the launcher runs and the database it serves (#6098: after the
# move to Rust, status still said PGlite)
engine_lines() {
  local engine; engine="$(cat "$PILO_HOME_DIR/engine" 2>/dev/null || true)"
  if [[ -n "$engine" && -x "$engine" ]]; then
    echo "engine:    rust, build ${engine##*/pilo-} ($engine)"
    echo "database:  $PILO_HOME_DIR/pilo.sqlite (SQLite)"
  else
    echo "engine:    node $(node -p 'require("./package.json").version' 2>/dev/null)"
    echo "database:  $PILO_HOME_DIR/data (PGlite) $([[ -d "$PILO_HOME_DIR/data" ]] && echo present || echo "not created yet")"
  fi
}

# A first run (no desk registered yet) is finished in the browser: say where,
# and open it unless --no-open or PILO_NO_OPEN says not to.
welcome() {
  curl -fsS "http://127.0.0.1:$(live_port)/api/setup" 2>/dev/null | grep -q '"piloAgents":\[\]' || return 0
  local url="http://127.0.0.1:$(live_port)/welcome"
  echo "Pilo is running. Finish setup in your browser: $url"
  if [[ "${1:-}" != "--no-open" && -z "${PILO_NO_OPEN:-}" ]] && command -v open >/dev/null 2>&1; then
    open "$url"
  fi
}

case "${1:-tui}" in
  tui|""|--no-open)
    ensure_server
    welcome "${2:-${1:-}}"
    PILO_PORT="$(live_port)" PILO_LAUNCH_CWD="$LAUNCH_CWD" node "$ROOT/src/tui.js"
    ;;
  # start/stop/restart, as systemctl and brew services name them; up and serve
  # stay as quiet aliases of start for hands and scripts that already use them
  start|up|serve)
    ensure_server
    echo "Pilo ready"
    ;;
  dashboard|dash)
    ensure_server
    command -v open >/dev/null 2>&1 && open "http://127.0.0.1:$(live_port)/dashboard"
    echo "Pilo dashboard opened"
    ;;
  stop)
    stop_server
    echo "Pilo server stopped"
    ;;
  restart)
    stop_server
    ensure_server
    echo "Pilo restarted"
    ;;
  update)
    # moves an installed copy to the newest release; a working copy is told how
    set +e
    node "$ROOT/src/update.js"
    code=$?
    set -e
    if [[ $code -eq 0 ]] && health; then
      stop_server
      ensure_server
      echo "Pilo restarted on the new version"
    fi
    [[ $code -eq 3 ]] && exit 0
    exit $code
    ;;
  status)
    if health; then echo "server:    running (port $(live_port))"; else echo "server:    stopped"; fi
    engine_lines
    ;;
  doctor)
    echo "root:      $ROOT"
    echo "home:      $PILO_HOME_DIR"
    echo "port file: $(live_port)"
    engine_lines
    if health; then
      echo "server:    running"
      curl -fsS "http://127.0.0.1:$(live_port)/api/system" | python3 -c '
import json, sys
d = json.load(sys.stdin)
for s in d["services"]:
    print("  %-10s %-9s %s" % (s["name"], s["state"], s["detail"]))
print("  wake failures: %d" % len(d["wakeFailures"]))
'
    else
      echo "server:    stopped — run 'pilo start'"
    fi
    ;;
  logs) tail -f "$LOG" ;;
  # the user's own: put Pilo's hooks into Claude Code / Codex, pair a phone
  hooks) [[ -n "$ENGINE" && "${2:-}" =~ ^(install|remove)$ ]] && exec "$PILO_HOME_DIR/bin/pilo" "$@"; exec node "$ROOT/src/hooks.js" "$@" ;;
  approvals) exec node "$ROOT/src/hooks.js" "$@" ;;
  # Every CLI command in src/commands.js has to be named here or it never
  # reaches the dispatcher — the shell answers with the usage line instead.
  # cli.test.js reads this list and that one, and fails when they drift.
  inbox|agents|send|reply|history|task|progress|done|block|blocked|ask|hold|resume|limited|answer|schedules|schedule|api)
    # agent commands go over the unix socket, so they work with sandbox network off
    [[ -n "$ENGINE" ]] && exec "$ENGINE" "$@"
    exec node "$ROOT/src/cli.js" "$@"
    ;;
  help|--help|-h) if [[ -n "$ENGINE" ]]; then "$ENGINE"; else node "$ROOT/src/cli.js"; fi ;;
  *) echo "Usage: pilo [tui|start|stop|restart|status|update|dashboard|doctor|logs|hooks|approvals]"; echo "       pilo [inbox|agents|send|reply|history|task|progress|done|schedules|api] — agent commands"; exit 1 ;;
esac
